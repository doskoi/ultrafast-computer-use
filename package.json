{
  "name": "jev-computer-use",
  "version": "0.1.0",
  "description": "Jev-guided, guarded navigation for OpenAI Computer Use accessibility trees",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
